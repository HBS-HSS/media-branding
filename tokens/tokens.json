{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Hierarchy Technologies — design token source of truth. W3C DTCG format. Do not edit derived files (tokens.css, tokens.scss, tokens.tailwind.cjs, tokens.dart, tokens.ts) directly; regenerate them from this file.",
  "color": {
    "brand": {
      "azure": {
        "50":  { "$value": "#EEF2FA", "$type": "color" },
        "100": { "$value": "#DBE3F4", "$type": "color" },
        "200": { "$value": "#B3C2E5", "$type": "color" },
        "300": { "$value": "#8AA1D7", "$type": "color" },
        "400": { "$value": "#6480C2", "$type": "color" },
        "500": { "$value": "#4261AD", "$type": "color", "$description": "Primary brand azure — extracted from logo gradient stop @ offset 0." },
        "600": { "$value": "#36529A", "$type": "color" },
        "700": { "$value": "#2A4280", "$type": "color" },
        "800": { "$value": "#1F3266", "$type": "color" },
        "900": { "$value": "#15224D", "$type": "color" }
      },
      "indigo": {
        "50":  { "$value": "#EFEDFA", "$type": "color" },
        "100": { "$value": "#DBD7F2", "$type": "color" },
        "200": { "$value": "#B6AEE0", "$type": "color" },
        "300": { "$value": "#8C82CB", "$type": "color" },
        "400": { "$value": "#635AB0", "$type": "color" },
        "500": { "$value": "#392F8E", "$type": "color", "$description": "Primary brand indigo — extracted from logo gradient stop @ offset .5." },
        "600": { "$value": "#2F2778", "$type": "color" },
        "700": { "$value": "#251E60", "$type": "color" },
        "800": { "$value": "#1B1648", "$type": "color" },
        "900": { "$value": "#110D30", "$type": "color" }
      },
      "violet": {
        "50":  { "$value": "#F0EDF9", "$type": "color" },
        "100": { "$value": "#DDD7F1", "$type": "color" },
        "200": { "$value": "#BAAEE0", "$type": "color" },
        "300": { "$value": "#9282CB", "$type": "color" },
        "400": { "$value": "#6A55AE", "$type": "color" },
        "500": { "$value": "#482D89", "$type": "color", "$description": "Primary brand violet — extracted from logo gradient stop @ offset 1." },
        "600": { "$value": "#3C2575", "$type": "color" },
        "700": { "$value": "#2F1D5F", "$type": "color" },
        "800": { "$value": "#221548", "$type": "color" },
        "900": { "$value": "#160D30", "$type": "color" }
      }
    },
    "neutral": {
      "0":    { "$value": "#FFFFFF", "$type": "color" },
      "50":   { "$value": "#FAFAFA", "$type": "color" },
      "100":  { "$value": "#F4F4F5", "$type": "color" },
      "200":  { "$value": "#E4E4E7", "$type": "color" },
      "300":  { "$value": "#D4D4D8", "$type": "color" },
      "400":  { "$value": "#A1A1AA", "$type": "color" },
      "500":  { "$value": "#71717A", "$type": "color" },
      "600":  { "$value": "#52525B", "$type": "color" },
      "700":  { "$value": "#3F3F46", "$type": "color" },
      "800":  { "$value": "#27272A", "$type": "color" },
      "900":  { "$value": "#231F20", "$type": "color", "$description": "Brand ink — extracted from logo wordmark fill (.cls-2)." },
      "1000": { "$value": "#000000", "$type": "color" }
    },
    "semantic": {
      "success": {
        "50":  { "$value": "#ECFDF5", "$type": "color" },
        "500": { "$value": "#16A34A", "$type": "color" },
        "700": { "$value": "#15803D", "$type": "color" }
      },
      "warning": {
        "50":  { "$value": "#FFFBEB", "$type": "color" },
        "500": { "$value": "#D97706", "$type": "color" },
        "700": { "$value": "#B45309", "$type": "color" }
      },
      "danger": {
        "50":  { "$value": "#FEF2F2", "$type": "color" },
        "500": { "$value": "#DC2626", "$type": "color" },
        "700": { "$value": "#B91C1C", "$type": "color" }
      },
      "info": {
        "50":  { "$value": "#EEF2FA", "$type": "color" },
        "500": { "$value": "{color.brand.azure.500}", "$type": "color" },
        "700": { "$value": "{color.brand.azure.700}", "$type": "color" }
      }
    },
    "surface": {
      "background": { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Default page background (light mode)." },
      "subtle":     { "$value": "{color.neutral.50}",  "$type": "color" },
      "raised":     { "$value": "{color.neutral.100}", "$type": "color" },
      "inverse":    { "$value": "{color.neutral.900}", "$type": "color", "$description": "Default page background (dark mode)." }
    },
    "text": {
      "primary":   { "$value": "{color.neutral.900}", "$type": "color", "$description": "Body text on light surfaces. AAA on background." },
      "secondary": { "$value": "{color.neutral.700}", "$type": "color" },
      "muted":     { "$value": "{color.neutral.500}", "$type": "color", "$description": "Use only for large text (AA only)." },
      "inverse":   { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Body text on inverse/dark surfaces." },
      "link":      { "$value": "{color.brand.azure.700}", "$type": "color", "$description": "AA-compliant link color on light surfaces." }
    },
    "gradient": {
      "brand": {
        "$type": "gradient",
        "$value": [
          { "color": "#4261AD", "position": 0   },
          { "color": "#392F8E", "position": 0.5 },
          { "color": "#482D89", "position": 1   }
        ],
        "$description": "Canonical 3-stop brand gradient from logo. Default angle 90deg (left → right). Use ON LIGHT SURFACES ONLY."
      },
      "brandReversed": {
        "$type": "gradient",
        "$value": [
          { "color": "#8AA1D7", "position": 0   },
          { "color": "#8C82CB", "position": 0.5 },
          { "color": "#9282CB", "position": 1   }
        ],
        "$description": "Light-shifted brand gradient (-300 ramp) for use on DARK surfaces only. Restores legibility against ink (#231F20) where the canonical gradient bleeds into the background."
      }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "'Sora', 'Manrope', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "body":    { "$value": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",            "$type": "fontFamily" },
      "mono":    { "$value": "'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "xs":   { "$value": "0.75rem",  "$type": "dimension", "$description": "12px" },
      "sm":   { "$value": "0.875rem", "$type": "dimension", "$description": "14px" },
      "base": { "$value": "1rem",     "$type": "dimension", "$description": "16px" },
      "lg":   { "$value": "1.125rem", "$type": "dimension", "$description": "18px" },
      "xl":   { "$value": "1.25rem",  "$type": "dimension", "$description": "20px" },
      "2xl":  { "$value": "1.563rem", "$type": "dimension", "$description": "25px (1.250 major-third)" },
      "3xl":  { "$value": "1.953rem", "$type": "dimension", "$description": "31.25px" },
      "4xl":  { "$value": "2.441rem", "$type": "dimension", "$description": "39.06px" },
      "5xl":  { "$value": "3.052rem", "$type": "dimension", "$description": "48.83px" },
      "6xl":  { "$value": "3.815rem", "$type": "dimension", "$description": "61.04px" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.1,  "$type": "number" },
      "snug":    { "$value": 1.25, "$type": "number" },
      "normal":  { "$value": 1.5,  "$type": "number" },
      "relaxed": { "$value": 1.75, "$type": "number" }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0",       "$type": "dimension" },
      "wide":   { "$value": "0.05em",  "$type": "dimension" },
      "wider":  { "$value": "0.12em",  "$type": "dimension", "$description": "Use for HIERARCHY-style wordmark display." }
    }
  },
  "space": {
    "0":  { "$value": "0",      "$type": "dimension" },
    "1":  { "$value": "0.25rem","$type": "dimension", "$description": "4px" },
    "2":  { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
    "3":  { "$value": "0.75rem","$type": "dimension", "$description": "12px" },
    "4":  { "$value": "1rem",   "$type": "dimension", "$description": "16px" },
    "5":  { "$value": "1.25rem","$type": "dimension", "$description": "20px" },
    "6":  { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
    "8":  { "$value": "2rem",   "$type": "dimension", "$description": "32px" },
    "10": { "$value": "2.5rem", "$type": "dimension", "$description": "40px" },
    "12": { "$value": "3rem",   "$type": "dimension", "$description": "48px" },
    "16": { "$value": "4rem",   "$type": "dimension", "$description": "64px" },
    "24": { "$value": "6rem",   "$type": "dimension", "$description": "96px" }
  },
  "radius": {
    "none":   { "$value": "0",       "$type": "dimension" },
    "sm":     { "$value": "0.25rem", "$type": "dimension" },
    "md":     { "$value": "0.5rem",  "$type": "dimension" },
    "lg":     { "$value": "0.75rem", "$type": "dimension" },
    "xl":     { "$value": "1rem",    "$type": "dimension" },
    "pill":   { "$value": "9999px",  "$type": "dimension" },
    "circle": { "$value": "50%",     "$type": "dimension" }
  },
  "shadow": {
    "xs": { "$value": "0 1px 2px 0 rgba(35, 31, 32, 0.05)",                                            "$type": "shadow" },
    "sm": { "$value": "0 1px 3px 0 rgba(35, 31, 32, 0.10), 0 1px 2px -1px rgba(35, 31, 32, 0.10)",     "$type": "shadow" },
    "md": { "$value": "0 4px 6px -1px rgba(35, 31, 32, 0.10), 0 2px 4px -2px rgba(35, 31, 32, 0.10)",  "$type": "shadow" },
    "lg": { "$value": "0 10px 15px -3px rgba(35, 31, 32, 0.10), 0 4px 6px -4px rgba(35, 31, 32, 0.10)","$type": "shadow" },
    "xl": { "$value": "0 20px 25px -5px rgba(35, 31, 32, 0.10), 0 8px 10px -6px rgba(35, 31, 32, 0.10)","$type": "shadow" }
  },
  "breakpoint": {
    "sm": { "$value": "640px",  "$type": "dimension" },
    "md": { "$value": "768px",  "$type": "dimension" },
    "lg": { "$value": "1024px", "$type": "dimension" },
    "xl": { "$value": "1280px", "$type": "dimension" },
    "2xl":{ "$value": "1536px", "$type": "dimension" }
  },
  "motion": {
    "duration": {
      "instant": { "$value": "0ms",   "$type": "duration" },
      "fast":    { "$value": "120ms", "$type": "duration" },
      "base":    { "$value": "200ms", "$type": "duration" },
      "slow":    { "$value": "320ms", "$type": "duration" },
      "slower":  { "$value": "480ms", "$type": "duration" }
    },
    "easing": {
      "linear":   { "$value": "linear",                              "$type": "cubicBezier" },
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)",          "$type": "cubicBezier" },
      "emphasis": { "$value": "cubic-bezier(0.3, 0, 0, 1)",          "$type": "cubicBezier" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0, 1)",          "$type": "cubicBezier" },
      "accelerate": { "$value": "cubic-bezier(0.3, 0, 1, 1)",        "$type": "cubicBezier" }
    }
  }
}
